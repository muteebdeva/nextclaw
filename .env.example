# NextClaw environment configuration (example — never commit real keys)

# Where NextClaw keeps its SQLite state
# NEXTCLAW_DATA_DIR=~/.nextclaw

# Workspace root the agent's tools are confined to
# NEXTCLAW_WORKSPACE=~/workspace

# --- Model providers ---
# Deterministic planner provider for `run` (default: stub)
# NEXTCLAW_MODEL_PROVIDER=stub

# LLM provider selection is now configuration, not code: add providers in the
# dashboard (Providers page), via POST /api/providers/configs, or the CLI.
# Legacy single-provider settings below are auto-migrated on first run.
# NEXTCLAW_LLM_PROVIDER=gemini
# NEXTCLAW_LLM_MODEL=gemini-3.7-flash

# API keys are read from the environment (preferred) — set only the ones you
# use, or store per-provider in the dashboard (masked, 0600).
# NEXTCLAW_GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# (see docs/PROVIDERS.md for the full list: Groq, OpenRouter, DeepSeek,
#  Mistral, xAI, Together, Fireworks, Cerebras, GitHub Models, HF, Bedrock…)

# Ollama (local models)
# NEXTCLAW_OLLAMA_URL=http://127.0.0.1:11434
# NEXTCLAW_OLLAMA_MODEL=

# --- Quota protection ---
# NEXTCLAW_LLM_TIMEOUT_S=60
# NEXTCLAW_LLM_MAX_PER_DAY=200
# Set to 1 to disable all model calls (everything fails closed)
# NEXTCLAW_OFFLINE=

# Set to 1 to run the live-model test (uses real API quota)
# NEXTCLAW_LIVE_TESTS=
